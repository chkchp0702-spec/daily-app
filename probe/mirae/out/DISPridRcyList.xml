ount() == 2)			{				grdMain.setCellData(0,0,"조회시작일");				grdMain.setCellData(1,0,"조회종료일");				grpFundInfo.show("");				//grdMain.setXML(e.responseBody); //인스턴스 바인딩 없이 바로 그리드에 바인딩				grdMain.show("");				testBode=e;				var vElspDt = WebSquare.xml.getValue(e.responseBody, 'root/message/DISPridRcyListDTO/uNoVal1');				var vPerYield = WebSquare.xml.getValue(e.responseBody, 'root/message/DISPridRcyListDTO/uNoVal2');				lblElpDt.setValue(vElspDt);				lblPeriodYield.setValue(vPerYield);			} else {				alert ("해당기준가가 없습니다. 기간을 다시 설정해 주세요.");			}		}var testBode;		function reset(){			fundReset();												calcDate(2,1);		}         ]]></script>    </head>    <body>		<xf:group class="common_table_section" id="group2" style="">			<xf:group class="common_table1" id="groupCommon" style="" tagname="table">				<w2:attributes>					<w2:summary>펀드와 조회기간을 설정할 수 있습니다.</w2:summary>					<w2:cellspacing>0</w2:cellspacing>					<w2:collpadding>0</w2:collpadding>				</w2:attributes>				<w2:textbox id="textbox11z" label="임의기간 수익률에 대한 검색조건을 선택합니다." style="" tagname="caption"></w2:textbox>				<xf:group class="" id="group4" style="" tagname="colgroup">					<xf:group class="" id="group5" style="" tagname="col">						<w2:attributes>							<w2:width>126</w2:width>						</w2:attributes>					</xf:group>					<xf:group class="" id="group6" style="" tagname="col">						<w2:attributes>							<w2:width>*</w2:width>						</w2:attributes>					</xf:group>				</xf:group>				<!-- 조회기간 -->				<xf:group class="" id="DISFundAnnSrch_date" style="" tagname="tr">					<xf:group class="table1_th" id="group139" style="" tagname="th">						<w2:textbox id="textbox66" label="조회기간" style="" tagname="p"></w2:textbox>					</xf:group>					<xf:group class="table1_td" id="group140" style="" tagname="td">						<w2:inputCalendar calendarImage="/img/com/ico_calendar.gif" title="시작일 선택"							calendarImageOver="/img/com/ico_calendar.g
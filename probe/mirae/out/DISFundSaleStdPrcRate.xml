Cd.getValue();		//운용사선택			if(vCompCd == "all" || vCompCd == null || vCompCd =="" || vCompCd == undefined) vCompCd = "";			var uFundNm = fundNm.getValue(); 	//펀드명			var uFrom = oFrom.getValue();		//설정원본액			var uTo     = oTo.getValue();			//설정원본액						CallProFrame.insertValue(DISCondFuncDTO, "tmpV30", vEndDt.toString());		//기준일자			CallProFrame.insertValue(DISCondFuncDTO, "tmpV22", vEndDt.toString());		//기준일자			CallProFrame.insertValue(DISCondFuncDTO, "tmpV3", ufundTyp);	//펀드유형			CallProFrame.insertValue(DISCondFuncDTO, "tmpV4", uareaGb);		//투자지역구분			CallProFrame.insertValue(DISCondFuncDTO, "tmpV5", ufundGb);	//펀드종류			CallProFrame.insertValue(DISCondFuncDTO, "tmpV7", ucomdity);	//모집형태 (공모/사모)			CallProFrame.insertValue(DISCondFuncDTO, "tmpV11", vCompCd);	//회사코드,(운용사선택)			CallProFrame.insertValue(DISCondFuncDTO, "tmpV12", uFundNm);	//펀드명				CallProFrame.insertValue(DISCondFuncDTO, "tmpV50", uFrom);		//설정원본액				CallProFrame.insertValue(DISCondFuncDTO, "tmpV51", uTo);			//설정원본액							//grid call 			MetaGridMaker.setGridData(vServiceId,null,null,true,DISCondFuncDTO); //그리드 헤더 초기화   		}   		   		function reset(){   			groupCommon.init();   			setStdDtOp(0, 'RD','DISFundSaleStdPrcRate');		//기준일 set   			compCd.setSelectedIndex(1);   		}		        ]]></script>	</head>	<body>		<xf:group class="" id="group1" style="" tagname="form" name="searchForm">			<w2:attributes>				<w2:name></w2:name>				<w2:action>DISFundSaleStdPrcRate.xml</w2:action>				<w2:method>post</w2:method>			</w2:attributes>			<xf:group class="common_table_section" id="group2" style="">				<xf:input id="sendTsCd" name="sendTsCd" value="" type="hidden"></xf:input><!-- 보고서 선택리스트  -->				<xf:input id="cdList" name="cdList" value="" type="hidden"></xf:input><!-- 펀드 선택리스트  -->				<xf:input id="sendCompCd" name="sendCompCd" value="" type="hidden"></xf:input><!-- 회사 선택리스트 -->				<xf:input id="compOpGb" name="compOpGb" value="" type="hidden"></xf:input>				<xf:input id="uFundLis
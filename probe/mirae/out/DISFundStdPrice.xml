<?xml version="1.0" encoding="UTF-8"?><html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"	xmlns:xf="http://www.w3.org/2002/xforms">	<head>		<script src="/js/cond/srchCond_compSelect.js" type="javascript"/>	<!-- 회사선택/운용사선택 -->		<script src="/js/cond/srchCond_rptType.js" type="javascript"/>		<!-- 보고서유형 -->		<script src="/js/cond/srchCond_fundSearch.js" type="javascript"/>	<!-- 펀드검색 -->		<script src="/js/cond/srchCond_inquiryPeriod.js" type="javascript"/>	<!-- 조회기간 -->		<script src="/js/cond/srchCond_etc.js" type="javascript"/>	<!-- 수익률/기준 외 -->				<w2:buildDate />		<xf:model>			<xf:instance>				<data xmlns="" />			</xf:instance>		</xf:model>		<script type="javascript"><![CDATA[				var objGridProp = GridProp();		var tabGb; //원화표시기준가펀드 : 0,  외화표시기준가펀드 : 1		var arrServicdID = [vServiceId,'SDIS01004001010']; //두번째 탭부터 하드코딩		$(function(){						initCond();		});		//조회조건 초기화		function initCond(){						if(vServiceId == "SDIS01004001010"){				setStdDtOp(0, 'RD','DISFundStdPriceF',manageInit);		//기준일 set			}else {				setStdDtOp(0, 'RD','DISFundStdPrice',manageInit);		//기준일 set			}							fundTypeSet('','Y');			//펀드유형 셋팅 set			function manageInit() { //기준일 세팅된 후 운용사 콤보 구성								if(vServiceId == "SDIS01004001010"){					compSelectBox(nextDate.getValue(),'DISFundStdPriceF');		//운용사선택 selectbox set					//nextDate.setValue(getToday());				}else {					compSelectBox(nextDate.getValue(),'DISFundStdPrice');		//운용사선택 selectbox set				}				}						//탭선택			var iTab = WebSquare.net.getParameter( "tab" );  // 디폴트 선택 탭 파라미터 - 외부에서 링크할때 초기 오픈될때 탭을 다르게 설정가능하도록 처리			if (!iTab) iTab = 0;			tabControl(iTab, initTab); //탭 초기화			MetaGridMaker.setGridData(vServiceId); //그리드 헤더 초기화					};				//탭 클릭시 해당 탭에 대해 컨텐츠 초기화		function initTab(index) {						tabGb = index;			vServiceId = arrServicdID[index];			MetaGridMaker.setGridData(vServiceId); //그리드 헤더 초기화						if(vServiceId == "SDIS01004001010"){				compSelectBox(nextDate.getValue(),'DISFundStdPriceF');		//운용사선택 selectbox set				//nextDate.setValue(getToday());			}else {				compSelectBox(nextDate.getValue(),'DISFundStdPrice');		//운용사선택 selectbox set			}				//reset();			//goSearch();					}					function goSearch(){			var DISCondFuncDTO = {'DISCondFuncDTO' : {}};						DISCondFuncDTO[metaDtoInfo.getOutMeta(vServiceId).inDto] = {};						var vEndDt = nextDate.getValue(); 		//기준일자			var ufundTyp = fundTyp.getValue(); 		//펀드유형			if(ufundTyp == "all") ufundTyp="";			var uareaGb = areaGb.getValue(); 		//투자지역구분			var ufundGb = fundGb.getValue(); 		//펀드종류			var ucomdity = comdity.getValue();		//모집형태 (공모/사모)			var vCompCd = compCd.getValue();		//운용사선택			if(vCompCd == "all" || vCompCd == null || vCompCd =="" || vCompCd == 'undefined') vCompCd = "";			var uFundNm = fundNm.getValue(); 	//펀드명			var uFrom = oFrom.getValue();		//설정원본액			var uTo     = oTo.getValue();			//설정원본액						CallProFrame.insertValue(DISCondFuncDTO, "tmpV30", vEndDt);		//기준일자			CallProFrame.insertValue(DISCondFuncDTO, "tmpV3", ufundTyp);	//펀드유형			CallProFrame.insertValue(DISCondFuncDTO, "tmpV4", uareaGb);		//투자지역구분			CallProFrame.insertValue(DISCondFuncDTO, "tmpV7", ucomdity);	//모집형태 (공모/사모)			CallProFrame.insertValue(DISCondFuncDTO, "tmpV5", ufundGb);	//펀드종류			CallProFrame.insertValue(DISCondFuncDTO, "tmpV11", vCompCd);	//회사코드,(운용사선택)			CallProFrame.insertValue(DISCondFuncDTO, "tmpV12", uFundNm);	//펀드명				CallProFrame.insertValue(DISCondFuncDTO, "tmpV50", uFrom);		//설정원본액				CallProFrame.insertValue(DISCondFuncDTO, "tmpV51", uTo);			//설정원본액							//grid call 			MetaGridMaker.setGridData(vServiceId,null,null,true,DISCondFuncDTO); //그리드 헤더 초기화  		}				function reset(){			groupCommon.init();						setStdDtOp(0, 'RD','DISFundStdPrice');		//기준일 set						compCd.setSelectedIndex(1);					//운용사 set					}        ]]></script>	</head>	<body>		<xf:group class="" id="group1" style="" tagnam
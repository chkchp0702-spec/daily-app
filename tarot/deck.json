[{"id":0,"s":"major","n":"0","nm":"바보","en":"The Fool","k":["시작","순수","무모함"],"e":6,"h":["아직 아무것도 정해지지 않았다","준비 없이 뛰어들었다"],"ad":["겁내지 말고 첫발을 떼세요","뛰기 전에 확인할 것 세 가지만 정하세요"],"img":"RWS_Tarot_00_Fool.jpg"},{"id":1,"s":"major","n":"I","nm":"마법사","en":"The Magician","k":["의지","실행력","자원"],"e":8,"h":["필요한 건 이미 다 갖고 있다","말만 앞서 있다"],"ad":["오늘 바로 하나를 실행하세요","말한 것 중 하나를 실제로 끝내세요"],"img":"RWS_Tarot_01_Magician.jpg"},{"id":2,"s":"major","n":"II","nm":"여사제","en":"The High Priestess","k":["직관","비밀","기다림"],"e":6,"h":["드러나지 않은 사정이 있다","감을 무시하고 있다"],"ad":["결정을 하루 미루고 감을 살피세요","불편한 느낌의 이유를 적어보세요"],"img":"RWS_Tarot_02_High_Priestess.jpg"},{"id":3,"s":"major","n":"III","nm":"여황제","en":"The Empress","k":["풍요","돌봄","감각"],"e":8,"h":["자라고 있는 것이 있다","베풀다 내가 비었다"],"ad":["재촉하지 말고 계속 돌보세요","내 몫을 먼저 챙기세요"],"img":"RWS_Tarot_03_Empress.jpg"},{"id":4,"s":"major","n":"IV","nm":"황제","en":"The Emperor","k":["질서","권위","경계"],"e":7,"h":["규칙을 세운 사람이 이긴다","고집이 문제를 만든다"],"ad":["기준을 문장으로 정해 붙이세요","한 가지는 상대 방식대로 해보세요"],"img":"RWS_Tarot_04_Emperor.jpg"},{"id":5,"s":"major","n":"V","nm":"교황","en":"The Hierophant","k":["전통","배움","제도"],"e":6,"h":["검증된 방법을 따르면 된다","틀에 억지로 맞추고 있다"],"ad":["먼저 해본 사람에게 물어보세요","남의 기준 하나를 버리세요"],"img":"RWS_Tarot_05_Hierophant.jpg"},{"id":6,"s":"major","n":"VI","nm":"연인","en":"The Lovers","k":["선택","결합","가치"],"e":7,"h":["둘 중 하나를 골라야 한다","끌림과 옳음이 갈라졌다"],"ad":["더 중요한 가치를 먼저 적으세요","미룬 대답을 이번 주에 하세요"],"img":"RWS_Tarot_06_Lovers.jpg"},{"id":7,"s":"major","n":"VII","nm":"전차","en":"The Chariot","k":["전진","의지","돌파"],"e":8,"h":["방향만 정하면 통과한다","힘이 사방으로 흩어진다"],"ad":["목표 하나만 남기고 밀어붙이세요","속도를 줄이고 방향을 다시 보세요"],"img":"RWS_Tarot_07_Chariot.jpg"},{"id":8,"s":"major","n":"VIII","nm":"힘","en":"Strength","k":["인내","부드러운 용기","길들임"],"e":7,"h":["버티는 힘으로 이긴다","참는 게 한계에 왔다"],"ad":["매일 조금씩 반복하세요","쉬고, 참는 걸 하나 그만두세요"],"img":"RWS_Tarot_08_Strength.jpg"},{"id":9,"s":"major","n":"IX","nm":"은둔자","en":"The Hermit","k":["성찰","고독","탐구"],"e":5,"h":["혼자 정리할 시간이 필요하다","혼자 있는 게 너무 길어졌다"],"ad":["하루 조용히 혼자 생각하세요","사람을 만나 이야기하세요